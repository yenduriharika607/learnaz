{
	"name": "products_api",
	"properties": {
		"activities": [
			{
				"name": "Copy data1",
				"type": "Copy",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "RestSource",
						"httpRequestTimeout": "00:01:40",
						"requestInterval": "00.00:00:00.010",
						"requestMethod": "GET"
					},
					"sink": {
						"type": "AzureSqlSink",
						"writeBehavior": "insert",
						"sqlWriterUseTableLock": false
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"path": "['id']"
								},
								"sink": {
									"name": "id",
									"type": "Int32"
								}
							},
							{
								"source": {
									"path": "['title']"
								},
								"sink": {
									"name": "title",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "['category']"
								},
								"sink": {
									"name": "category",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "['price']"
								},
								"sink": {
									"name": "price",
									"type": "Decimal"
								}
							},
							{
								"source": {
									"path": "['meta']['updatedAt']"
								},
								"sink": {
									"name": "modified_date",
									"type": "DateTime"
								}
							}
						],
						"collectionReference": "$['products']"
					}
				},
				"inputs": [
					{
						"referenceName": "RestResource1",
						"type": "DatasetReference",
						"parameters": {
							"watermarkcol": {
								"value": "@pipeline().parameters.watermark_col",
								"type": "Expression"
							},
							"watermarkval": {
								"value": "@pipeline().parameters.watermark_val",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference",
						"parameters": {
							"target_tbl": {
								"value": "@pipeline().parameters.target_tbl",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "Web1",
				"type": "WebActivity",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"url": {
						"value": "@concat('https://dummyjson.com/','products','?',pipeline().parameters.watermark_col,'=',pipeline().parameters.watermark_val)",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"target_tbl": {
				"type": "string"
			},
			"watermark_col": {
				"type": "string"
			},
			"watermark_val": {
				"type": "string"
			},
			"vSkip": {
				"type": "int"
			},
			"vTotal": {
				"type": "int"
			},
			"vPageSize": {
				"type": "int",
				"defaultValue": 30
			}
		},
		"annotations": []
	}
}